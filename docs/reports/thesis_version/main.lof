\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces Cosmic distances span from nearby stars to the largest known structures in the universe, measured on scales of light-years, typically up to the order of 10. Each label represents either the distance to a notable astronomical object or the size of a vast cosmic region. The diameter of the observable universe is roughly 93 billion light-years, which is nearly the order of 11.}}{4}{figure.caption.6}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces In galactic plane, Sgr A* towards 0 h direction, Sun located at the center surrounded with stars upto 15 lightyears distance. Credit: ESO/R.-D. Scholz et al. (AIP)}}{4}{figure.caption.7}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces A segment of the Milky Way depicting the Solar System and its neighboring nebulae located in the Orion–Cygnus Arm. The Galactic Center and other minor arms - Norma and Carina–Sagittarius are also highlighted. Credits: Andrew Z. Colvin (wikipedia)}}{5}{figure.caption.8}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces Structure of the Milky Way galaxy, illustrating the central bulge, the prominent spiral arm pattern, and the distribution of selected X-ray sources. Credit: NASA/CXC/M.Weiss}}{5}{figure.caption.9}%
\contentsline {figure}{\numberline {1.5}{\ignorespaces Spatial distribution of Milky Way and Andromeda along with multitude of dwarf galaxies within the Local Group. Source: Andrew Z. Colvin (Wikipedia)}}{6}{figure.caption.10}%
\contentsline {figure}{\numberline {1.6}{\ignorespaces Galaxy superclusters and voids within $10^9$ ly of Virgo Supercluster. Source: Andrew Z. Colvin (Wikipedia)}}{7}{figure.caption.11}%
\contentsline {figure}{\numberline {1.7}{\ignorespaces Large-scale structure of the Universe illustrating the cosmic web. \textit {Source: S. Stapelberg, Structures blog from the University of Heidelberg}}}{8}{figure.caption.12}%
\contentsline {figure}{\numberline {1.8}{\ignorespaces Two remarkable discoveries of early twentieth century: a) Leavitt Law: Period (in logarithmic scale) of 25 Cepheids (of Small Magellanic Cloud) correlated with their maximum and minimum brightness. \cite {1912leavitt} b) Hubble Law: Increasing recession velocity of galaxies with respect to distance suggesting an expanding Universe. \cite {1929hubble}}}{10}{figure.caption.13}%
\contentsline {figure}{\numberline {1.9}{\ignorespaces The fractional composition of the Universe consists of dark energy (68 \%), dark matter (27 \%), and baryonic matter (5 \%) is depicted, with the contributions from radiation and other relativistic particles neglected. Source: University of Zurich Dark Matter webpage \citep {UZHcosmicRecipe}}}{12}{figure.caption.14}%
\contentsline {figure}{\numberline {1.10}{\ignorespaces An instance of Cosmic Distance Ladder calibrating Leavitt Law with parallax, SNIa with Leavitt Law and Hubble Law with SNIa based distances. \citep {2022riess}}}{13}{figure.caption.15}%
\contentsline {figure}{\numberline {1.11}{\ignorespaces Anisotropies in the CMB observed by the Planck satellite; tiny temperature fluctuations trace density variations that seeded cosmic structure. The CMB was released in the recombination phase when the Universe was 380{,}000 years old \citep {planck2018}. Credits: ESA/Planck Collaboration}}{15}{figure.caption.16}%
\contentsline {figure}{\numberline {1.12}{\ignorespaces \textit {K-band Period-Luminosity relation for Galactic Cepheid using IRSB distance.} Source: \citep {2011storm}}}{17}{figure.caption.17}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Spectrum of Light showing different bands with respective wavelength range. Source: www.healthlighting.com}}{22}{figure.caption.18}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces \textit {Black body radiation curves based on Planck’s Law for various temperatures. The maxima of the curves shift according to Wien’s displacement law. Source: Wikipedia commons}}}{22}{figure.caption.19}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces \small {Comparision between emitted (0) and observed (1) SEDs. For given band, deviation between the curves represents interstellar extinction (here, $A_B$ and $A_V$). On the right side, the relative difference between extinction of two bands depicting the definition of interstellar reddening $E(B-V)$. \citep {1993krelowski}}}}{27}{figure.caption.20}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces \small {Galactic extinction law fitted for UBRIJHKL along three directions in the sky, with varying $R_V$, with $A_V$ as reference. \citep {1989cardelli}}}}{29}{figure.caption.21}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces As Earth orbits the Sun, nearby stars appear to shift against distant background stars—this shift, called parallax, is used to measure their distance using trignometric ratio. Source: \cite {hyperphysics_parallax} webpage}}{32}{figure.caption.23}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Observational evidence of Beker's hypothesis \citep {1960Svolopoulos}. Surface brightness versus color variation for four Cepheids.}}{34}{figure.caption.24}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Variation in color (x-axis) and radius (y-axis) over the pulsation cycle of Cepheid (clockwise). Figure 3 of \cite {1946wesselink} depicting }}{35}{figure.caption.25}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Cluster membership detection methodology used by\cite {2023cruz} to determine the distance to cluster Cepheids.}}{37}{figure.caption.26}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Distance and luminosity scaling law}}{39}{figure.caption.27}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {3.1}{\ignorespaces \small Notes taken from \textit {Energy Production in Stars} \citep {1939bethe} , concluding that helium-3 is more stable than tritium.}}{44}{figure.caption.28}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Isochrones of stars with different masses depicting their evolutionary tracks in Hertzsprung-Russell (HR) diagram. Red line shows the zero-age main sequence (ZAMS), while black line marks the turn-off point, followed by the first dredge-up and evolution toward the red giant phase. Asterisk (*) indicates the helium flash in intermediate-mass stars, whereas more massive stars evolve through the second and possibly third dredge-up. \citep {Freedman2020}}}{47}{figure.caption.29}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces \textbf {Stellar Evolution of Sun-type star:} \textbf {a)} Gravitational collapse of a gas cloud forms a protostar which begin to fuse Hydrogen and arrived to the main sequence. \textbf {b)} After billions of years, star leaves the main sequence and become a Red Giant. At the tip of the Red Giant branch, star spontaneously fuses Helium with a short the episode of Helium flash and slowly moves to horizontal branch \textbf {c)} Intermediate star evolve through AGB phase, expanding upto the size of Jupiter orbit and loses its envelope to form a planetary nebula at the age of 12 billion years. \textbf {d)} Ejecting way the outer envelope, the remnant of dead star shines due to the degeneracy pressure of its electron and resides in lower left of HR diagram as a White Dwarf. Source: Sketch taken from \citep {kaufmann1978}}}{53}{figure.caption.31}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Pulsation cycle of Cepheid variable - brightness, radius and radial velocity. Source: Website \cite {schoolphysics_cepheid} }}{54}{figure.caption.32}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces The gray region depicts the instability strip defined by \cite {2003tammann}, while the wedge-shaped dark blue solid lines show the instability strip modeled by \cite {2000bono}. Comparison between different stellar evolutionary tracks studied by \citep {2014anderson}. }}{55}{figure.caption.33}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces \cite {1953zhevakin} Cepheid model with H–He composition 85–15\%, interior divided into three regions: (a) internal zone, (b) critical ionization zone of \ce {He^+}, and (c) atmosphere, shown in relative scale. The background plot displays the variation of specific heat at constant volume $c_V$ with respect to stellar radius, along with the locations of the critical ionization zones of \ce {H}, \ce {He}, and \ce {He^+}.}}{56}{figure.caption.34}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Densogram showing the distribution of 150 Galactic classical Cepheids. The top two rows present distance distributions derived from two independent methods, highlighting subtle differences between the results. The third row shows reddening estimates, scaled by a factor of ten for visualization. The remaining row display photometric measurements in the $K$, $H$, $J$, $I$, $V$, and $B$ bands, ordered from top to bottom.}}{59}{figure.caption.35}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Outliers are filtered using 15 combinations of period--color plots. Out of 143 Cepheids, 13 GCCs arbitrarily move away from the generic trend of the instability strip for certain color combinations. These sources are marked with their respective index numbers and are listed in Table~\ref {outliers}. Remains 130 Cepheids.}}{62}{figure.caption.37}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Deviation between reddened and unreddened wesenheit magnitude. \cite {2007fouque} Extinction law and Reddening ratio \cite {2004sandage} $R_V = 3.23$ }}{64}{figure.caption.39}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Deviation between wesenheit magnitude using adjusted extinction law and reddening ratio. Decreased deviation in W with respect to standard values (compare with Figure \ref {wesF}). }}{64}{figure.caption.40}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Magnitude Transformation: Red - Apparent ; Magenta - True Apparent ; Yellow - True Absolute ; Green and Cyan - Composite Wesenheits. }}{65}{figure.caption.41}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Fifteen families of Wesenheit function derived from BVIJHK bands. The colored area represents individual wesenheit family of respective color covering six wesenheit functions.}}{66}{figure.caption.42}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Composite reddening ratio $R^{12}_\lambda $ calculated with adjusted extinction law for 15 color combination made with BVIJHK bands. \textbf {Left:} Among 8 colors, $B-V$ and $V-I$ are the largest ones. \textbf {Right:} Notice five-fold scaling of $H-K$ and $J-H$ with respect to $B-V$. Value of $R^{VK}_B$ approaching to 1.5}}{67}{figure.caption.43}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces \textbf {First Panel:} Leavitt Law prior to calibration (121 GCCs, IRSB distance). \textbf {Second Panel:} Gaia distance based Leavitt Law}}{68}{figure.caption.44}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Composite Period - Wesenheit Relations. \textbf {First:} \cite {2017madore} used V-I based wesenheit magnitude with IRSB distance. \textbf {Second:} In this research V-K color index is used. \textbf {Third:} Gaia distance based Period-Wesenheit relation for V-K color.}}{69}{figure.caption.45}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces Slope and Intercept of BVIJHK PL and PW relations, for $\log P -1$. }}{69}{figure.caption.46}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Schematic illustration of the distance–reddening–luminosity relationship.}}{70}{figure.caption.47}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces $\Delta W$ - $\Delta M$ correlation plots shown for VK wesenheit - IRSB and Gaia. With increasing wavelength, slope is approaching to 1.}}{72}{figure.caption.49}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Distance-reddening error trails for stars \textbf {B} and \textbf {C}}}{73}{figure.caption.50}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Reddening error estimated using two approaches, Madore (M) and Shubham (S), for Gaia- and IRSB-based distances, for the $V-I$ (top panel) and $V-K$ (bottom panel) colors. The comparison is shown for one of the most highly reddened Cepheids in the dataset, V0916 Aql, with $E_{BV} = 1.089$. Larger deviation in the M-method is due to the fixed $W^{12}_V$-based PW residuals, which systematically deviate along the anchors of the color band. Equation~\ref {MS} accounts for this systematic scatter in the reddening error and application of it makes the method more precise - S method.}}{76}{figure.caption.52}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Three key steps for decoupling distance--reddening errors. (a) Construct multiple distance--reddening error trails for each band. (b) Cross-match the error pairs across the bands in the distance--reddening plane. (c) Identify the distance trail that yields the least deviation in reddening across the bands.}}{78}{figure.caption.53}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Determination of reddening and distance error for a Cepheid using $V-K$ wesenheit function. Least variance over modulus error for BVIJHK based reddening suggests suitable correction pair. Dashed blue line depicts the variance.}}{79}{figure.caption.54}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Gaia-based BVIJHK PL relations calibrated with $V-K$ wesenheit. Red color represents calibrated absolute magnitude.}}{80}{figure.caption.55}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Calibrated Period-Wesenheit relations for $V-K$ (Gaia)}}{80}{figure.caption.56}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces IRSB-based calibrated PL relations}}{81}{figure.caption.57}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Calibrated Period-Wesenheit relations for $V-K$ (IRSB)}}{81}{figure.caption.58}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces \small Blue points show the deviation between IRSB and Gaia distances before calibration. After $V-K$ based calibration, the deviation decreases, the mean offset between the two remains unchanged 0.129 mag with reduced scatter of 0.038 mag. The deviation in reddening is small, with a scatter of 0.0005 mag.}}{87}{figure.caption.60}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces \small Deviations in distance and reddening corrections for the $V-K$ based calibration, with respect to measurements of 17 cluster Cepheids \citep {2023cruz}. Stars with deviations larger than 0.2~mag in distance or 0.04~mag in reddening are annotated and marked with a red dot. The mean and scatter are indicated.}}{88}{figure.caption.61}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Distance–reddening calibration data pipeline. \textbf {I:} Determination of the reddening ratio for the composite Wesenheit magnitude. \textbf {II:} Derivation of the true absolute magnitude from the observed data. \textbf {III:} Correlation between period, luminosity, and Wesenheit magnitudes, and the residuals of $\Delta W$–$\Delta M$ correlation. \textbf {IV:} Estimation of extinction errors across photometric bands for an individual Cepheid. \textbf {V:} Decoupling distance - reddening errors by introducing distance-error trials and identifying the minimum RMS across bands. \textbf {VI:} Final distance–reddening calibrated true absolute magnitudes of Cepheids.}}{89}{figure.caption.62}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Distance (left) and reddening (right) corrections for Gaia distances estimated using different color combination. X-axis shows deviation in correction with respect to Cluster Cepheid dataset. Y-axis represents period (in logarithm scale) of 17 Cepheids annotated with respective names.}}{91}{figure.caption.63}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {7.1}{\ignorespaces 121 Galactic Cepheids around the Sun with distance ranging from 7 to 13.5 magnitude, where highly redden Cepheids colored darker.}}{96}{figure.caption.64}%
\contentsline {figure}{\numberline {7.2}{\ignorespaces LMC and SMC distances determined from the zero-points of VIJK Leavitt Laws}}{99}{figure.caption.65}%
\contentsline {figure}{\numberline {7.3}{\ignorespaces The Small Magellanic Cloud (SMC) viewed from two perspectives: (A) From a face-on angle, the reddening is relatively uniform. (B) Cepheids in the background are more highly reddened compared to those in the foreground.}}{100}{figure.caption.67}%
