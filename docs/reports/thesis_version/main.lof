\addvspace {10\p@ }
\contentsline {figure}{\numberline {1.1}{\ignorespaces Cosmic distances span from nearby stars to the largest known structures in the universe, measured on scales of light-years, typically up to the order of 10. Each label represents either the distance to a notable astronomical object or the size of a vast cosmic region. The diameter of the observable universe is roughly 93 billion light-years, which is nearly the order of 11.}}{3}{figure.caption.3}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces \textit {Left:} Stars located within 15ly. \textit {Right:} A segment of the Milky Way depicting the Solar System and its neighboring nebulae located in the Orion–Cygnus Arm. The Galactic Center and other minor arms - Norma and Carina–Sagittarius - are also highlighted. Credit: ESO/R.-D. Scholz et al. (AIP) (left) Andrew Z. Colvin (wikipedia) \citep {2018MilkyWay}(right)}}{4}{figure.caption.4}%
\contentsline {figure}{\numberline {1.3}{\ignorespaces \textit {Left:} Side view of the Milky Way, depicting its components and satellite galaxies, notably the Large and Small Magellanic Clouds (LMC and SMC). \textit {Right:} Spatial distribution of galaxies within the Local Group, dominated by the Milky Way and Andromeda galaxies. Source: Wikipedia - Pablo Carlos Budassi (left) and Andrew Z. Colvin (right)}}{5}{figure.caption.5}%
\contentsline {figure}{\numberline {1.4}{\ignorespaces Galaxy supercluster and voids within $10^9$ ly of Virgo Supercluster. Source: Andrew Z. Colvin (Wikipedia)}}{5}{figure.caption.6}%
\contentsline {figure}{\numberline {1.5}{\ignorespaces Large-scale structure of the Universe illustrating the cosmic web. \textit {Source: S. Stapelberg, Structures blog from the University of Heidelberg}}}{7}{figure.caption.7}%
\contentsline {figure}{\numberline {1.6}{\ignorespaces Two remarkable discoveries of early twentieth century: a) Leavitt Law: Period (in logarithmic scale) of 25 Cepheids (of Small Magellanic Cloud) correlated with their maximum and minimum brightness. \cite {1912leavitt} b) Hubble Law: Increasing recession velocity of galaxies with respect to distance suggesting an expanding Universe. \cite {1929hubble}}}{8}{figure.caption.8}%
\contentsline {figure}{\numberline {1.7}{\ignorespaces \textit {K-band Period-Luminosity relation for Galactic Cepheid using IRSB distance.} Source: Storm J., 2011}}{15}{figure.caption.9}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {2.1}{\ignorespaces Spectrum of Light showing different bands with respective wavelength range. Source: www.healthlighting.com}}{20}{figure.caption.10}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces \textit {Black body radiation curves based on Planck’s Law for various temperatures. The maxima of the curves shift according to Wien’s displacement law. Source: Wikipedia commons}}}{20}{figure.caption.11}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces \small {Comparision between emitted (0) and observed (1) SEDs. For given band, deviation between the curves represents interstellar extinction (here, $A_B$ and $A_V$). On the right side, the relative difference between extinction of two bands depicting the definition of interstellar reddening $E(B-V)$. \citep {1993krelowski}}}}{25}{figure.caption.12}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces \small {Galactic extinction law fitted for UBRIJHKL along three directions in the sky, with varying $R_V$, with $A_V$ as reference. \citep {1989cardelli}}}}{26}{figure.caption.13}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces As Earth orbits the Sun, nearby stars appear to shift against distant background stars—this shift, called parallax, is used to measure their distance using trignometric ratio. \tiny \hfill \textit {Source: hyperphysics.phy-astr.gsu.edu}}}{30}{figure.caption.16}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Linear relation between surface brightness and color. \cite {1960Svolopoulos}}}{31}{figure.caption.17}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Figure 3 of \cite {1946wesselink}}}{32}{figure.caption.18}%
